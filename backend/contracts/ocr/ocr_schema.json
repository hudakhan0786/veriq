{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCRContract",
  "description": "Multilingual Text Detection and Recognition Output Contract for SIH26034",
  "type": "object",
  "required": ["image_id", "total_tokens", "mean_confidence", "tokens", "full_text", "execution_time_ms"],
  "properties": {
    "image_id": { "type": "string" },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "mean_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "full_text": { "type": "string" },
    "execution_time_ms": { "type": "integer", "minimum": 0 },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token_id", "text", "confidence", "polygon", "bounding_box"],
        "properties": {
          "token_id": { "type": "string" },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "language": { "type": "string" },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 4,
            "maxItems": 4
          },
          "bounding_box": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
