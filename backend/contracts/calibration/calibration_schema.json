{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalibrationContract",
  "description": "Metric Scale Calibration and PDP Geometry Contract for SIH26034 Nirikshak",
  "type": "object",
  "required": ["is_calibrated", "calibration", "principal_display_panel"],
  "properties": {
    "is_calibrated": {
      "type": "boolean"
    },
    "calibration": {
      "type": "object",
      "required": ["method", "px_to_mm", "confidence", "reference_bounding_box"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["ARUCO_4X4_50", "ISO_7810_CARD", "STANDARD_COIN", "MANUAL_FIXED", "UNRESOLVED"]
        },
        "px_to_mm": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "reference_bounding_box": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 4,
          "maxItems": 4
        },
        "margin_of_error_pct": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "principal_display_panel": {
      "type": "object",
      "required": ["package_area_cm2", "pdp_area_cm2", "pdp_area_percentage", "bounding_box"],
      "properties": {
        "package_type": {
          "type": "string",
          "enum": ["RECTANGULAR", "CYLINDRICAL", "FLEXIBLE_POUCH", "UNSPECIFIED"]
        },
        "package_area_cm2": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "pdp_area_cm2": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "pdp_area_percentage": {
          "type": "number"
        },
        "bounding_box": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
